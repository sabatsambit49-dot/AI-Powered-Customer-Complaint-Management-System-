# Groq API Key (Obtain from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app

# Database Configuration (PostgreSQL)
# Local Docker / Neon Serverless Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pharma_complaints

# LLM Model Configuration (Groq models)
PRIMARY_MODEL=gemma2-9b-it
REASONING_MODEL=llama-3.3-70b-versatile
